          <ThreadId>5</ThreadId>
          <Name>Jellyfin</Name>
        </KnownTopic>
        <KnownTopic>
          <ThreadId>7</ThreadId>
          <Name>Films</Name>
        </KnownTopic>
      </KnownTopics>
      <Events>
        <string>media.movie</string>
        <string>media.episodes</string>
        <string>security.login_failed</string>
      </Events>
      <LibraryIds>
        <string>0123456789abcdef0123456789abcdef</string>
