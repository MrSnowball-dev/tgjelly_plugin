<?xml version="1.0" encoding="utf-8"?>
<PluginConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SchemaVersion>2</SchemaVersion>
  <Revision>41</Revision>
  <Language>en</Language>
  <PublicUrl>https://jf.example.com</PublicUrl>
  <Proxy>
    <Mode>Http</Mode>
    <Url>http://10.0.0.2:3128</Url>
  </Proxy>
  <Message>
    <PerMessage>
      <MessageSwitchesEntry>
        <EventKey>media.movie</EventKey>
        <Switches>
          <ShowPoster>false</ShowPoster>
          <ShowOverview>true</ShowOverview>
          <ShowRatingGenres>true</ShowRatingGenres>
          <ShowOpenInJellyfin>true</ShowOpenInJellyfin>
          <ShowProviderLinks>true</ShowProviderLinks>
        </Switches>
      </MessageSwitchesEntry>
    </PerMessage>
    <AnnounceUpgrades>true</AnnounceUpgrades>
  </Message>
  <Batching>
    <QuietWindowSeconds>90</QuietWindowSeconds>
    <MaxHoldMinutes>25</MaxHoldMinutes>
    <ReleaseQuietSeconds>15</ReleaseQuietSeconds>
    <DigestThreshold>8</DigestThreshold>
    <LateEditHours>4</LateEditHours>
    <ReadyTimeoutMinutes>12</ReadyTimeoutMinutes>
  </Batching>
  <UpdateCheck>
    <Enabled>true</Enabled>
    <Fixes>false</Fixes>
    <NewReleases>true</NewReleases>
    <NewMajor>true</NewMajor>
  </UpdateCheck>
  <Destinations>
