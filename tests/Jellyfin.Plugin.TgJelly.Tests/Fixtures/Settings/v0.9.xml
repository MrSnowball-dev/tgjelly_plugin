      <ChatId>-1003514547050</ChatId>
      <ThreadId>5</ThreadId>
      <Title>Family</Title>
      <Kind>Supergroup</Kind>
      <Enabled>true</Enabled>
      <IsForum>true</IsForum>
      <Preset>Custom</Preset>
      <TopicRoutes>
