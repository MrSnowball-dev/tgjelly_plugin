<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.TgJelly</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.TgJelly</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XmlSerializer-friendly config uses arrays (spec §10.1), like jellyfin-plugin-webhook. -->
    <NoWarn>$(NoWarn);CA1819</NoWarn>
  </PropertyGroup>

  <!-- Jellyfin 12 build: .NET 10, compiled against the lowest 12.x packages (spec §13.2). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);JF12</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped in the zip (build/package.py ASSEMBLIES). RetryThreshold = 0 on every client (spec F39). -->
    <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
    <PackageReference Include="Scriban" Version="7.5.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.TgJelly.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\tgjelly.html" />
    <EmbeddedResource Include="Web\tgjelly.js" />
    <EmbeddedResource Include="Web\tgjelly-ui.js" />
    <EmbeddedResource Include="Web\tgjelly-autosave.js" />
    <EmbeddedResource Include="Web\tgjelly-messages.js" />
    <EmbeddedResource Include="Web\tgjelly-preview.js" />
    <EmbeddedResource Include="Web\tgjelly-log.js" />
    <EmbeddedResource Include="Web\tgjelly.css" />
    <EmbeddedResource Include="Strings\en.json" />
    <EmbeddedResource Include="Templates/BuiltIn/**/*.sbn" WithCulture="false" />
    <EmbeddedResource Include="Templates/sample-poster.png" />
    <EmbeddedResource Include="../../build/logo.png" LogicalName="Jellyfin.Plugin.TgJelly.Logo.png" />
  </ItemGroup>

</Project>
